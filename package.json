{
    "name": "ex-installer-electron",
    "version": "0.1.0",
    "description": "EX-Installer - Electron/Aurelia 2 frontend",
    "private": true,
    "main": "out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "dev:mock": "electron-vite dev -- --mock-device",
        "debug": "electron-vite dev --inspect=9229",
        "build": "electron-vite build",
        "toolchain:fetch": "node scripts/fetch-toolchain.mjs",
        "package": "pnpm build && electron-builder",
        "preview": "electron-vite preview",
        "start": "electron-vite dev",
        "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
        "lint": "eslint src --ext .ts,.html",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "pnpm build && playwright test",
        "test:all": "pnpm test && pnpm test:e2e",
        "clean": "rimraf out src/out release dist",
        "clean:all": "pnpm run clean && rimraf node_modules src/node_modules"
    },
    "dependencies": {
        "@aurelia/dialog": "2.0.0-rc.1",
        "@aurelia/router": "2.0.0-rc.1",
        "@aurelia/vite-plugin": "^2.0.0-rc.0",
        "@fontsource/roboto": "^5.2.10",
        "@syncfusion/ej2": "^32.1.24",
        "@xterm/addon-canvas": "^0.7.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "aurelia": "^2.0.0-rc.0",
        "electron-store": "^11.0.2",
        "monaco-editor": "^0.55.1",
        "python-shell": "^5.0.0",
        "serialport": "^12.0.0",
        "simple-git": "^3.32.1",
        "tar": "^7.5.9",
        "usb": "^2.13.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@tailwindcss/vite": "^4.2.0",
        "@types/node": "^24.10.13",
        "@types/tar": "^7.0.87",
        "electron": "^40.6.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "postcss-import": "^16.1.1",
        "rimraf": "^5.0.1",
        "tailwindcss": "^4.2.0",
        "typescript": "^5.7.0",
        "vite": "^7.3.1",
        "vite-plugin-monaco-editor": "^1.1.0",
        "vitest": "^4.0.18"
    },
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0"
    },
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
    "build": {
        "appId": "org.dcc-ex.installer",
        "productName": "EX-Installer",
        "directories": {
            "output": "release"
        },
        "files": [
            "out/**/*",
            "package.json",
            "node_modules/**/*"
        ],
        "asarUnpack": [
            "**/*.node"
        ],
        "extraResources": [
            {
                "from": "src/python",
                "to": "python-scripts"
            },
            {
                "from": "resources/python",
                "to": "python"
            },
            {
                "from": "resources/pio",
                "to": "pio"
            },
            {
                "from": "resources/pio-core",
                "to": "pio-core"
            },
            {
                "from": "resources/pio-libs",
                "to": "pio-libs"
            },
            {
                "from": "resources/toolchain-manifest.json",
                "to": "toolchain-manifest.json"
            }
        ],
        "nativeRebuilder": "prebuild-install",
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility"
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "mac": {
            "target": [
                "dmg"
            ]
        }
    }
}
